package sqliteDemo;

declare "C" from "stdio.h" {
    int32 printf(const char* format, ...);
}

declare "C" from "sqlite_helper.h" {
    int32 artc_sqlite_open(const char* filename, void** ppDb);
    int32 artc_sqlite_exec(void* db, const char* sql, void** errmsg);
    void  artc_sqlite_close(void* db);
    void  artc_sqlite_free(void* ptr);
    void* artc_sqlite_errmsg(void* db);
}

public void Run() {
    void* db = null;
    void* errMsg = null;
    int32 rc = 0;

    // open database
    rc = artc_sqlite_open("test.db", &db);
    if (rc != 0) {
        printf("Can't open database: %s\n", artc_sqlite_errmsg(db));
    }
    else {
        printf("Database is opened\n");
    }

    // drop table users
    void* sql_drop_users = "DROP TABLE IF EXISTS users;";
    rc = artc_sqlite_exec(db, sql_drop_users, &errMsg);
    if (rc != 0) {
        printf("SQL error: %s\n", errMsg);
        artc_sqlite_free(errMsg);
    }
    else {
        printf("Table users is dropped\n");
    }

    // create table users
    void* sql_create_users = "CREATE TABLE users(id INT, name TEXT, password TEXT, email TEXT, PRIMARY KEY(id));";
    rc = artc_sqlite_exec(db, sql_create_users, &errMsg);
    if (rc != 0) {
        printf("SQL error: %s\n", errMsg);
        artc_sqlite_free(errMsg);
    }
    else {
        printf("Table users is created\n");
    }

    // insert data
    void* sql_insert_user = "INSERT INTO users VALUES(1, \"admin\", \"123456\", \"admin@abc.com\");";
    rc = artc_sqlite_exec(db, sql_insert_user, &errMsg);
    if (rc != 0) {
        printf("SQL error: %s\n", errMsg);
        artc_sqlite_free(errMsg);
    }
    else {
        printf("Insert data is finished\n");
    }

    // close database
    artc_sqlite_close(db);

    printf("Info: database is closed\n");
}